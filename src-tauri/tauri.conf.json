{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drawnix",
  "version": "0.1.0",
  "identifier": "com.drawnix.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:7200",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist/apps/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drawnix",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["drawnix"],
        "mimeType": "application/vnd.drawnix+json",
        "description": "Drawnix board",
        "role": "Editor"
      }
    ]
  }
}